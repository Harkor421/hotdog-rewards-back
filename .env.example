# =============================================================================
# COSTCO — one hot dog, every five minutes, to everyone holding the coin.
# Copy to .env and fill in. .env is git-ignored; NEVER commit a real key.
# =============================================================================

PORT=8080
ROUND_MS=300000          # 5 minutes. Rounds align to the wall clock.
HOTDOG_USD=1             # what one hot dog costs. This is the whole promise.

# --- arming ------------------------------------------------------------------
# Two switches, both off. PAYOUTS=1 turns the counter on; DRY_RUN=false is what
# actually lets money leave. Run with DRY_RUN=true first and watch a few rounds.
PAYOUTS=0
DRY_RUN=true

# --- the coin ----------------------------------------------------------------
TOKEN=                   # $COSTCO's contract address. Holders of this get fed.

# --- the treasury ------------------------------------------------------------
DISTRIBUTOR_PRIVATE_KEY= # holds the money, pays the gas. NEVER commit this.
LEAVE_ETH=0.002          # native coin held back for gas, never spent on food

# --- what a dollar is made of ------------------------------------------------
# native : send $1 worth of ETH. No pool, no stablecoin, works on day one.
# erc20  : pay in a USD-pegged token, bought through the swap router.
PAYOUT_ASSET=native
PAYOUT_TOKEN=
PAYOUT_TOKEN_USD=1

# --- how the round is split --------------------------------------------------
# flat    : everybody gets HOTDOG_USD. The promise on the tin.
# prorata : the round's budget split by holdings (Stock Royale's shape).
PAYOUT_MODE=flat

# The brake. A round never spends more than this share of the treasury, no
# matter how long the queue gets. At 4%, the till survives ~25 rounds even if
# nothing is ever added to it — and the frontend publishes that runway.
MAX_ROUND_PCT=4
MAX_ROUND_USD=

# --- eligibility -------------------------------------------------------------
# ⚠ MIN_ELIGIBLE_PCT is the single most important number here.
#   A flat dollar per WALLET is farmable in a way a pro-rata split is not: a
#   hundred wallets is a hundred dollars. This floor is what stops that, and it
#   doubles as a cap on the bill — at 0.1%, at most 1,000 wallets can ever
#   qualify, so a round can never cost more than $1,000. Do not set it to 0.
MIN_ELIGIBLE_PCT=0.1
MAX_HOLDER_PCT=50
MAX_RECIPIENTS=500
EXCLUDE_CONTRACTS=true
EXCLUDE_ADDRESSES=

# --- chain -------------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com

# The PRO host. The public explorer sits behind a Cloudflare challenge and
# answers servers 403 with an HTML page — which reads downstream as "this coin
# has no holders". See README > Who actually holds the coin.
BLOCKSCOUT_URL=https://api.blockscout.com/4663
BLOCKSCOUT_API_KEY=

# With no key, holders are read straight off the chain instead.
CHAIN_FALLBACK=true
TOKEN_START_BLOCK=
CHAIN_MAX_CALLS=400
MIN_SUPPLY_COVERAGE=40
DISCOVERY_TARGET=99.5
VERIFY_ONCHAIN=true

# --- pool / bonding-curve exclusion ------------------------------------------
# A contract holding this much of supply is infrastructure, not a mouth.
POOL_MIN_PCT=0.5
POOL_CANDIDATES=0x8366a39cc670b4001a1121b8f6a443a643e40951,0x52d571fe77027298e06e52fc4434e1507f819268

# --- swap router (only used when PAYOUT_ASSET=erc20) -------------------------
WETH=0x0bd7d308f8e1639fab988df18a8011f41eacad73
SWAP_ROUTER=0xCb0615a1478838DeA20E57447309be97f45DcA0f
BUY_SLIPPAGE_PCT=20

# --- receipts ----------------------------------------------------------------
# Optional. Without it the totals reset every deploy, and /stats says so.
MONGO_URL=

# --- dev ---------------------------------------------------------------------
# Synthesize a queue so the frontend can be built before a real coin exists.
# Everything it produces is stamped demo:true and the page labels it.
DEMO_HOLDERS=0
DEMO_TILL_USD=500
